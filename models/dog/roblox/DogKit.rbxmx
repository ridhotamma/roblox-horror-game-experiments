<Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">DogAnimator</string><ProtectedString name="Source">--!nonstrict
-- DogAnimator: plays the Dog's baked clips (DogAnimations) on the imported skinned mesh by writing Bone.Transform.
-- No animation upload, no Animator/KeyframeSequence: the clips ship as data and run anywhere the model goes.
--
-- Why it is robust to the import: every frame of a clip stores, per bone, a rotation delta in Blender's model axes
-- (how far the bone has turned from its rest orientation) plus the DogRoot offset. At start the animator reads the
-- imported rest skeleton (Bone.CFrame chain) and fits Blender's axes onto it from three bones (DogRoot, Hips, Head):
-- so it does not matter how the 3D Importer rotated, scaled or offset the model, or which local axes it gave each
-- bone. Positions are never taken from the data except the root offset; children ride on their parents.
--
-- Bone.Transform does not replicate: run this on every client (DogController is a Script with RunContext Client).
--
-- API
--   local anim = DogAnimator.new(model, DogAnimations)
--   anim:SetLocomotion(speedStudsPerSecond)   -- picks Idle / Walk / Run and the playback rate (call every frame)
--   anim:Crouch()                             -- jump anticipation (frames 0-9); hold until Jump()
--   anim:Jump()                               -- push off and the airborne poses; holds the last air pose
--   anim:Land()                               -- landing, then back to locomotion
--   anim:PlayIdleVariant(name?)               -- play an idle variant now (random one if name is nil)
--   anim:SetIdleVariantDelay(min, max)        -- seconds of plain Idle between variants (default 6-12; nil = off)
--
-- Face (eyelids and pupils, see DogAnimations.face): the dog blinks on its own every 2-6 s (sometimes twice) and its
-- pupils widen when it runs or jumps. Override with:
--   anim:Blink()                              -- blink now
--   anim:SetAutoBlink(enabled)                -- turn the automatic blinking on / off
--   anim:SetEyelids(amount?)                  -- hold the lids at 0 (open) .. 1 (shut), e.g. sleepy 0.6; nil = auto
--   anim:SetPupil(size?)                      -- 0 narrow (bright light) .. 0.5 normal .. 1 wide (dark, excited);
--                                                nil = automatic
--   anim:Step(dt)                             -- advance and write the bones
--   anim:Destroy()                            -- bones back to rest

local DogAnimator = {}
DogAnimator.__index = DogAnimator

local WALK_RUN_SWITCH = 0.55 -- switch to Run above this fraction of the way from walk speed to run speed
local IDLE_BELOW = 0.35      -- studs/s (at the native scale) below which the dog stands
local FADE = 0.18            -- seconds for locomotion cross-fades
local VARIANT_FADE = 0.35    -- softer blend into and out of idle variants (sit, sniff, shake...)
local VARIANT_DELAY = { 6, 12 } -- seconds of plain Idle before the next variant
local BLINK_GAP = { 2, 6 }   -- seconds between automatic blinks
local DOUBLE_BLINK = 0.2     -- chance that a blink is followed by a second one
local PUPIL_RATE = 4         -- how fast the pupils follow their target (1/s)

-- ------------------------------------------------------------------ quaternions as plain numbers (x, y, z, w)
local function qget(arr, frame)
	local i = frame * 4
	return arr[i + 1], arr[i + 2], arr[i + 3], arr[i + 4]
end

local function basis(a: Vector3, b: Vector3, c: Vector3): CFrame
	-- right-handed frame from three points: X along b-&gt;c, Y the part of b-&gt;a orthogonal to it
	local e1 = (c - b).Unit
	local v = a - b
	local e2 = (v - e1 * v:Dot(e1)).Unit
	local e3 = e1:Cross(e2)
	return CFrame.fromMatrix(Vector3.zero, e1, e2, e3)
end

local function vec(t)
	return Vector3.new(t[1], t[2], t[3])
end

local function axisAngle(a, angle: number): CFrame
	local s = math.sin(angle / 2)
	return CFrame.new(0, 0, 0, a[1] * s, a[2] * s, a[3] * s, math.cos(angle / 2))
end

local function ease(x: number): number
	x = math.clamp(x, 0, 1)
	return 0.5 - 0.5 * math.cos(math.pi * x)
end

-- ------------------------------------------------------------------ construction
function DogAnimator.fromBones(bones: { any }, data)
	local self = setmetatable({}, DogAnimator)
	self.data = data
	self.fps = data.fps
	self.byName = {}
	for _, b in bones do
		self.byName[b.Name] = b
	end

	-- the bones we drive, parents first; anything the import dropped is reported once and skipped
	self.order = {}
	local missing = {}
	for _, name in data.order do
		if self.byName[name] then
			table.insert(self.order, name)
		else
			table.insert(missing, name)
		end
	end
	if #missing &gt; 0 then
		warn("[DogAnimator] bones missing from the imported rig: " .. table.concat(missing, ", "))
	end
	for _, need in { "DogRoot", "Hips", "Head" } do
		assert(self.byName[need], "[DogAnimator] the rig needs a bone named " .. need)
	end

	-- rest pose in the frame of the part that holds the skeleton (chain of Bone.CFrame; Transform is ignored)
	self.rest = {}
	self.isBoneParent = {}
	local function restOf(b)
		local r = self.rest[b.Name]
		if r then
			return r
		end
		local p = b.Parent
		if p and p:IsA("Bone") then
			r = restOf(p) * b.CFrame
			self.isBoneParent[b.Name] = true
		else
			r = b.CFrame
		end
		self.rest[b.Name] = r
		return r
	end
	for _, name in self.order do
		restOf(self.byName[name])
	end

	-- fit Blender model axes -&gt; rig space: rotation M and scale s (Blender metres -&gt; studs as imported)
	local R = data.rest
	local bb = basis(vec(R.DogRoot), vec(R.Hips), vec(R.Head))
	local rr = basis(self.rest.DogRoot.Position, self.rest.Hips.Position, self.rest.Head.Position)
	self.M = rr * bb:Inverse()
	self.Minv = self.M:Inverse()
	self.s = (self.rest.Head.Position - self.rest.Hips.Position).Magnitude / (vec(R.Head) - vec(R.Hips)).Magnitude
	-- the scale relative to what the clips were made for (speeds scale with it)
	self.scale = self.s / data.studsPerMetre

	-- check the fit on every bone: a mirrored or rebuilt skeleton would not line up
	local worst = 0
	local rootPos = self.rest.DogRoot.Position
	for _, name in self.order do
		local want = rootPos + self.M:VectorToWorldSpace((vec(R[name]) - vec(R.DogRoot)) * self.s)
		worst = math.max(worst, (self.rest[name].Position - want).Magnitude)
	end
	self.fitError = worst / self.s -- in Blender metres
	if self.fitError &gt; 0.01 then
		warn(("[DogAnimator] the imported skeleton does not match the clip data (off by %.3f m); poses may look wrong")
			:format(self.fitError))
	end

	-- constant offsets of each bone head from its parent's rest frame (children ride on their parents)
	self.offset = {}
	for _, name in self.order do
		local parent = data.parents[name]
		if parent and self.rest[parent] then
			self.offset[name] = self.rest[parent]:PointToObjectSpace(self.rest[name].Position)
		end
	end

	-- idle variants: one-shot clips flagged idleVariant, played now and then while standing
	self.idleVariants = {}
	for name, clip in data.clips do
		if clip.idleVariant then
			table.insert(self.idleVariants, name)
		end
	end
	table.sort(self.idleVariants)
	self.variantDelay = { VARIANT_DELAY[1], VARIANT_DELAY[2] }
	self.idleClock = 0
	self.nextVariantAt = self:_rollDelay()

	-- face layer state
	self.faceData = data.face
	self.autoBlink = true
	self.nextBlink = BLINK_GAP[1] + math.random() * (BLINK_GAP[2] - BLINK_GAP[1])
	self.blinkTime = nil -- seconds into the current blink (negative = waiting for a double blink)
	self.lid = 0
	self.pupil = 0.5

	self.tracks = {}
	self.mode = "ground" -- ground | crouch | jump | air | land
	self.locoName = nil
	self.locoRate = 1
	self.world = {}
	return self
end

function DogAnimator.new(model: Instance, data)
	local bones = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Bone") then
			table.insert(bones, d)
		end
	end
	return DogAnimator.fromBones(bones, data)
end

-- ------------------------------------------------------------------ tracks
-- A track plays frames [from, to] of a clip; loops wrap, one-shots hold the last frame and call onEnd once.
function DogAnimator:_play(name, opts)
	opts = opts or {}
	local clip = self.data.clips[name]
	assert(clip, "no clip " .. tostring(name))
	local last = clip.loop and clip.frames or clip.frames - 1
	local track = {
		name = name,
		clip = clip,
		from = opts.from or 0,
		to = opts.to or last,
		time = opts.from or 0,
		rate = opts.rate or 1,
		loop = clip.loop and opts.from == nil and opts.to == nil,
		weight = opts.fade == 0 and 1 or 0,
		target = 1,
		fade = opts.fade or FADE,
		onEnd = opts.onEnd,
		ended = false,
	}
	for _, t in self.tracks do
		t.target = 0
		t.fade = opts.fade or FADE
	end
	table.insert(self.tracks, track)
	return track
end

function DogAnimator:_advance(dt)
	local keep = {}
	for _, t in self.tracks do
		if t.fade &lt;= 0 then
			t.weight = t.target
		elseif t.weight &lt; t.target then
			t.weight = math.min(t.target, t.weight + dt / t.fade)
		elseif t.weight &gt; t.target then
			t.weight = math.max(t.target, t.weight - dt / t.fade)
		end
		t.time += dt * self.fps * t.rate
		if t.loop then
			t.time = t.from + (t.time - t.from) % (t.to - t.from)
		elseif t.time &gt;= t.to then
			t.time = t.to
			if not t.ended then
				t.ended = true
				if t.onEnd then
					t.onEnd()
				end
			end
		end
		if t.weight &gt; 0 or t.target &gt; 0 then
			table.insert(keep, t)
		end
	end
	self.tracks = keep
end

-- ------------------------------------------------------------------ face: eyelids and pupils
function DogAnimator:Blink()
	if not self.blinkTime or self.blinkTime &lt; 0 then
		self.blinkTime = 0
	end
end

function DogAnimator:SetAutoBlink(enabled: boolean)
	self.autoBlink = enabled ~= false
end

function DogAnimator:SetEyelids(amount: number?)
	self.lidOverride = amount and math.clamp(amount, 0, 1) or nil
end

function DogAnimator:SetPupil(size: number?)
	self.pupilOverride = size and math.clamp(size, 0, 1) or nil
end

function DogAnimator:_stepFace(dt: number)
	local f = self.faceData
	if not f then
		return
	end
	if self.autoBlink and not self.blinkTime then
		self.nextBlink -= dt
		if self.nextBlink &lt;= 0 then
			self.blinkTime = 0
			self.doubleBlink = math.random() &lt; DOUBLE_BLINK
			self.nextBlink = BLINK_GAP[1] + math.random() * (BLINK_GAP[2] - BLINK_GAP[1])
		end
	end
	local lid = 0
	local t = self.blinkTime
	if t then
		local b = f.blink
		if t &lt; 0 then
			lid = 0
		elseif t &lt; b.close then
			lid = ease(t / b.close)
		elseif t &lt; b.close + b.hold then
			lid = 1
		elseif t &lt; b.close + b.hold + b.open then
			lid = 1 - ease((t - b.close - b.hold) / b.open)
		end
		t += dt
		if t &gt;= b.close + b.hold + b.open then
			if self.doubleBlink then
				self.doubleBlink = false
				t = -0.08
			else
				t = nil
			end
		end
		self.blinkTime = t
	end
	self.lid = lid
	-- pupils: wide while running or in the air, normal otherwise (or what the game asked for)
	local target = self.pupilOverride
	if not target then
		if self.mode ~= "ground" then
			target = 0.85
		elseif self.locoName == "Run" then
			target = 0.75
		else
			target = 0.5
		end
	end
	self.pupil += (target - self.pupil) * (1 - math.exp(-dt * PUPIL_RATE))
end

-- face bones turn about their own axis on top of the head's motion: D = D_head * Q(axis, angle)
function DogAnimator:_faceRot(rot)
	local f = self.faceData
	if not f then
		return
	end
	local head = rot.Head or CFrame.identity
	local lid = math.max(self.lid, self.lidOverride or 0)
	for name, l in f.lids do
		if self.byName[name] then
			rot[name] = head * axisAngle(l.axis, l.closed * lid)
		end
	end
	local p = self.pupilOverride or self.pupil
	for name, q in f.pupils do
		if self.byName[name] then
			local a = if p &lt; 0.5 then q.narrow * (1 - p / 0.5) else q.wide * ((p - 0.5) / 0.5)
			rot[name] = head * axisAngle(q.axis, a)
		end
	end
end

-- ------------------------------------------------------------------ idle variants
function DogAnimator:_rollDelay()
	local d = self.variantDelay
	if not d then
		return math.huge
	end
	return d[1] + math.random() * (d[2] - d[1])
end

function DogAnimator:SetIdleVariantDelay(minSeconds: number?, maxSeconds: number?)
	self.variantDelay = minSeconds and { minSeconds, maxSeconds or minSeconds } or nil
	self.idleClock = 0
	self.nextVariantAt = self:_rollDelay()
end

function DogAnimator:_stopVariant()
	self.variantTrack = nil
	self.variantName = nil
	self.idleClock = 0
	self.nextVariantAt = self:_rollDelay()
end

function DogAnimator:PlayIdleVariant(name: string?)
	if self.mode ~= "ground" or #self.idleVariants == 0 then
		return nil
	end
	if not name then
		-- random, but never the same one twice in a row
		local pool = {}
		for _, n in self.idleVariants do
			if n ~= self.variantName and n ~= self.lastVariant then
				table.insert(pool, n)
			end
		end
		if #pool == 0 then
			pool = self.idleVariants
		end
		name = pool[math.random(1, #pool)]
	end
	local track
	track = self:_play(name, {
		fade = VARIANT_FADE,
		onEnd = function()
			if self.variantTrack == track then
				-- it ends on the standing pose: hand back to the Idle loop with a soft blend
				self:_stopVariant()
				self.locoName = nil
				self.locoFade = VARIANT_FADE
			end
		end,
	})
	self.variantTrack = track
	self.variantName = name
	self.lastVariant = name
	return track
end

-- ------------------------------------------------------------------ locomotion and jump states
function DogAnimator:SetLocomotion(speed: number)
	local clips = self.data.clips
	local v = speed / self.scale -- in the clips' native studs/s
	if self.mode ~= "ground" then
		self.pendingSpeed = v
		return
	end
	local walkV, runV = clips.Walk.speed, clips.Run.speed
	local name, rate
	if v &lt; IDLE_BELOW then
		name, rate = "Idle", 1
	else
		local switch = walkV + (runV - walkV) * WALK_RUN_SWITCH
		-- a little hysteresis so the gait doesn't flicker at the threshold
		if self.locoName == "Run" then
			switch *= 0.9
		end
		if v &gt;= switch then
			name, rate = "Run", math.clamp(v / runV, 0.7, 1.5)
		else
			name, rate = "Walk", math.clamp(v / walkV, 0.45, 1.9)
		end
	end
	if self.variantTrack then
		if name == "Idle" then
			return -- the variant is the idle for now
		end
		self:_stopVariant() -- started moving: leave the variant with a soft blend
		self.locoFade = VARIANT_FADE
	end
	if name ~= self.locoName or not self.locoTrack or self.locoTrack.target == 0 then
		self.locoName = name
		self.locoTrack = self:_play(name, { fade = self.locoFade })
		self.locoFade = nil
		if name == "Idle" then
			self.idleClock = 0
		end
	end
	self.locoTrack.rate = rate
end

function DogAnimator:_marker(key)
	local m = self.data.clips.Jump.markers
	return m[key][1], m[key][2]
end

function DogAnimator:Crouch()
	if self.mode ~= "ground" then
		return
	end
	self.mode = "crouch"
	self:_stopVariant()
	local a = self:_marker("takeoff")
	self.locoTrack = nil
	self:_play("Jump", { from = a, to = 9, fade = 0.08 })
end

function DogAnimator:Jump()
	if self.mode == "air" or self.mode == "jump" then
		return
	end
	local cued = self.mode == "crouch" -- otherwise no anticipation: start at the push-off
	self.mode = "jump"
	self:_stopVariant()
	self.locoTrack = nil
	local _, takeoffEnd = self:_marker("takeoff")
	local airFrom, airTo = self:_marker("air")
	local function air()
		if self.mode ~= "jump" then
			return
		end
		self.mode = "air"
		self:_play("Jump", { from = airFrom, to = airTo, fade = 0.05 })
	end
	if cued then
		-- continue the crouch track straight into the push-off
		local t = self.tracks[#self.tracks]
		if t and t.name == "Jump" then
			t.to = takeoffEnd
			t.ended = false
			t.rate = 1.6
			t.onEnd = air
			return
		end
	end
	self:_play("Jump", { from = 9, to = takeoffEnd, rate = 1.6, fade = 0.06, onEnd = air })
end

function DogAnimator:Fall()
	-- walked off a ledge: go straight to the airborne poses
	if self.mode == "ground" or self.mode == "land" then
		self.locoTrack = nil
		self:_stopVariant()
		local airFrom, airTo = self:_marker("air")
		self.mode = "air"
		self:_play("Jump", { from = math.floor((airFrom + airTo) / 2), to = airTo, fade = 0.12 })
	end
end

function DogAnimator:Land()
	if self.mode == "ground" or self.mode == "land" then
		return
	end
	self.mode = "land"
	local a, b = self:_marker("land")
	local moving = (self.pendingSpeed or 0) &gt; self.data.clips.Walk.speed * 1.2
	self:_play("Jump", {
		from = a,
		to = moving and a + 5 or b, -- running on: only the absorb, then straight back into the gait
		fade = 0.05,
		onEnd = function()
			if self.mode == "land" then
				self.mode = "ground"
				self.locoName = nil
				self:SetLocomotion((self.pendingSpeed or 0) * self.scale)
			end
		end,
	})
end

-- ------------------------------------------------------------------ pose evaluation
local function sampleRot(clip, bone, time, loop)
	local arr = clip.rot[bone]
	if not arr then
		return 0, 0, 0, 1
	end
	local n = clip.frames
	local f0 = math.floor(time)
	local a = time - f0
	local f1 = f0 + 1
	if loop then
		f0 %= n
		f1 %= n
	else
		f0 = math.clamp(f0, 0, n - 1)
		f1 = math.clamp(f1, 0, n - 1)
	end
	local x0, y0, z0, w0 = qget(arr, f0)
	local x1, y1, z1, w1 = qget(arr, f1)
	if x0 * x1 + y0 * y1 + z0 * z1 + w0 * w1 &lt; 0 then
		x1, y1, z1, w1 = -x1, -y1, -z1, -w1
	end
	return x0 + (x1 - x0) * a, y0 + (y1 - y0) * a, z0 + (z1 - z0) * a, w0 + (w1 - w0) * a
end

local function sampleRoot(clip, time, loop)
	local arr = clip.root
	local n = clip.frames
	local f0 = math.floor(time)
	local a = time - f0
	local f1 = f0 + 1
	if loop then
		f0 %= n
		f1 %= n
	else
		f0 = math.clamp(f0, 0, n - 1)
		f1 = math.clamp(f1, 0, n - 1)
	end
	local i, j = f0 * 3, f1 * 3
	local x = arr[i + 1] + (arr[j + 1] - arr[i + 1]) * a
	local y = arr[i + 2] + (arr[j + 2] - arr[i + 2]) * a
	local z = arr[i + 3] + (arr[j + 3] - arr[i + 3]) * a
	if clip.physicsLift and z &gt; 0 then
		z = 0 -- the Humanoid jump moves the body up; keep only the crouch/landing dips
	end
	return x, y, z
end

-- blended pose: {bone = CFrame rotation (Blender axes)}, root offset (Blender metres)
function DogAnimator:_blend()
	local total = 0
	for _, t in self.tracks do
		total += t.weight
	end
	local rot = {}
	local rx, ry, rz = 0, 0, 0
	if total &lt;= 1e-4 then
		self:_faceRot(rot)
		return rot, Vector3.zero
	end
	local norm = math.max(total, 1) -- weights below 1 in total blend toward the rest pose
	for _, name in self.order do
		local x, y, z, w = 0, 0, 0, math.max(0, 1 - total)
		for _, t in self.tracks do
			if t.weight &gt; 0 then
				local qx, qy, qz, qw = sampleRot(t.clip, name, t.time, t.loop)
				if qx * x + qy * y + qz * z + qw * w &lt; 0 then
					qx, qy, qz, qw = -qx, -qy, -qz, -qw
				end
				local k = t.weight / norm
				x += qx * k
				y += qy * k
				z += qz * k
				w += qw * k
			end
		end
		local len = math.sqrt(x * x + y * y + z * z + w * w)
		if len &gt; 1e-6 then
			rot[name] = CFrame.new(0, 0, 0, x / len, y / len, z / len, w / len)
		end
	end
	for _, t in self.tracks do
		if t.weight &gt; 0 then
			local x, y, z = sampleRoot(t.clip, t.time, t.loop)
			local k = t.weight / norm
			rx += x * k
			ry += y * k
			rz += z * k
		end
	end
	self:_faceRot(rot)
	return rot, Vector3.new(rx, ry, rz)
end

-- write Bone.Transform for the blended pose
function DogAnimator:_apply(rot, rootOffset)
	local world = self.world
	local M, Minv = self.M, self.Minv
	for _, name in self.order do
		local bone = self.byName[name]
		local rest = self.rest[name]
		local d = rot[name]
		local dr = d and (M * d * Minv) or CFrame.identity
		local parent = self.data.parents[name]
		local pos
		if parent and world[parent] then
			pos = world[parent]:PointToWorldSpace(self.offset[name])
		else
			pos = rest.Position + M:VectorToWorldSpace(rootOffset * self.s)
		end
		local w = CFrame.new(pos) * dr * rest.Rotation
		world[name] = w
		-- bone world = parentWorld * Bone.CFrame * Transform
		local parentWorld = (parent and self.isBoneParent[name]) and world[parent] or CFrame.identity
		bone.Transform = (parentWorld * bone.CFrame):Inverse() * w
	end
end

function DogAnimator:Step(dt: number)
	if self.mode == "ground" and self.locoName == "Idle" and not self.variantTrack then
		self.idleClock += dt
		if self.idleClock &gt;= self.nextVariantAt then
			self:PlayIdleVariant()
		end
	end
	self:_advance(dt)
	self:_stepFace(dt)
	local rot, root = self:_blend()
	self:_apply(rot, root)
end

-- for tests and tools: show one frame of one clip with full weight
function DogAnimator:Pose(name: string, frame: number)
	local clip = self.data.clips[name]
	self.tracks = { { name = name, clip = clip, time = frame, rate = 0, loop = clip.loop, weight = 1, target = 1,
		fade = 0, from = 0, to = clip.frames - 1, ended = true } }
	local rot, root = self:_blend()
	self:_apply(rot, root)
end

function DogAnimator:Destroy()
	for _, name in self.order do
		self.byName[name].Transform = CFrame.identity
	end
	self.tracks = {}
end

return DogAnimator
</ProtectedString></Properties></Item>
<Item class="Script" referent="RBX3"><Properties><string name="Name">DogController</string><token name="RunContext">2</token><bool name="Disabled">true</bool><ProtectedString name="Source">-- DogController: animates this Dog on the local client from its Humanoid (speed and jump state).
-- A Script with RunContext = Client inside the Dog model (DogSetup puts it there). Bone.Transform is not replicated,
-- so every client runs its own copy; the server only moves the Humanoid (DogBrain, or your own AI).
--
-- Model attribute "JumpCue": bump it (any new value) ~0.2 s before setting Humanoid.Jump to get the crouch
-- anticipation; jumps without a cue start at the push-off.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CULL_DISTANCE = 250 -- studs from the camera; farther dogs keep their last pose

local model = script.Parent
local kit = ReplicatedStorage:WaitForChild("DogKit")
local DogAnimator = require(kit:WaitForChild("DogAnimator"))
local DogAnimations = require(kit:WaitForChild("DogAnimations"))

local humanoid = model:WaitForChild("Humanoid") :: Humanoid
local root = model:WaitForChild("HumanoidRootPart") :: BasePart
-- the skeleton streams in with its MeshPart (DogSetup makes the model Atomic); wait for the last bone we need
local function hasBones()
	local n = 0
	for _, d in model:GetDescendants() do
		if d:IsA("Bone") then
			n += 1
		end
	end
	return n &gt;= #DogAnimations.order
end
while not hasBones() do
	model.DescendantAdded:Wait()
end

local anim = DogAnimator.new(model, DogAnimations)

local State = Enum.HumanoidStateType
humanoid.StateChanged:Connect(function(_old, new)
	if new == State.Jumping then
		anim:Jump()
	elseif new == State.Freefall then
		anim:Fall() -- only acts when walking off a ledge; a jump is already in the air poses
	elseif new == State.Landed or new == State.Running or new == State.RunningNoPhysics then
		anim:Land()
	end
end)

model:GetAttributeChangedSignal("JumpCue"):Connect(function()
	anim:Crouch()
end)

local conn
conn = RunService.RenderStepped:Connect(function(dt)
	if not model.Parent or not root.Parent then
		conn:Disconnect()
		return
	end
	local cam = workspace.CurrentCamera
	if cam and (cam.CFrame.Position - root.Position).Magnitude &gt; CULL_DISTANCE then
		return
	end
	local v = root.AssemblyLinearVelocity
	anim:SetLocomotion(Vector3.new(v.X, 0, v.Z).Magnitude)
	anim:Step(math.min(dt, 0.1))
end)

model.Destroying:Connect(function()
	conn:Disconnect()
end)
</ProtectedString></Properties></Item>
<Item class="Script" referent="RBX4"><Properties><string name="Name">DogBrain</string><bool name="Disabled">true</bool><ProtectedString name="Source">-- DogBrain: a small companion AI so every animation shows up in play: follows the nearest player (walks when
-- close, runs to catch up, stands idle beside you and hops now and then), wanders around its spawn when nobody is
-- near, and jumps over low obstacles in its way. Replace it with your own AI any time: DogController only looks at
-- the Humanoid's speed and jump state. Set the model attribute DogAI = false to switch this off.

local Players = game:GetService("Players")

local model = script.Parent
local humanoid = model:WaitForChild("Humanoid") :: Humanoid
local root = model:WaitForChild("HumanoidRootPart") :: BasePart

-- 1 = the size the clips were made for (HumanoidRootPart 0.62 m long at 4.5 studs/m)
local scale = root.Size.Z / (0.62 * 4.5)
local WALK_SPEED = 5 * scale
local RUN_SPEED = 15 * scale
local NEAR = 6 * scale -- stop this far from the player
local FAR = 20 * scale -- run beyond this
local SIGHT = 120 -- notice players within this many studs
local WANDER_RADIUS = 30 * scale

pcall(function()
	root:SetNetworkOwner(nil) -- the server moves the dog; nobody's client gets authority over it
end)

local home = root.Position
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

local function groundOffset()
	return humanoid.HipHeight + root.Size.Y / 2 -- root centre to the ground
end

local jumping = false
local function cueJump()
	if jumping or humanoid.FloorMaterial == Enum.Material.Air then
		return
	end
	jumping = true
	model:SetAttribute("JumpCue", (model:GetAttribute("JumpCue") or 0) + 1) -- clients play the crouch
	task.wait(0.22)
	humanoid.Jump = true
	task.delay(0.8, function()
		jumping = false
	end)
end

-- a low obstacle straight ahead that the jump can clear?
local function obstacleAhead()
	local filter = { model }
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(filter, p.Character)
		end
	end
	params.FilterDescendantsInstances = filter
	local fwd = root.CFrame.LookVector
	local feet = root.Position - Vector3.yAxis * (groundOffset() - 0.4 * scale)
	local hit = workspace:Raycast(feet, fwd * 3.5 * scale, params)
	if not hit or hit.Normal.Y &gt; 0.6 then
		return false -- nothing, or just a slope
	end
	local maxUp = humanoid.JumpHeight * 0.9
	local top = workspace:Raycast(hit.Position + fwd * 0.5 + Vector3.yAxis * (maxUp + 0.4 * scale),
		-Vector3.yAxis * (maxUp + 0.4 * scale), params)
	return top ~= nil -- found a top below the jump height
end

local function nearestPlayer()
	local best, bestD = nil, SIGHT
	for _, p in Players:GetPlayers() do
		local c = p.Character
		local hrp = c and c:FindFirstChild("HumanoidRootPart")
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if hrp and h and h.Health &gt; 0 then
			local d = (hrp.Position - root.Position).Magnitude
			if d &lt; bestD then
				best, bestD = hrp, d
			end
		end
	end
	return best, bestD
end

local nextHop = os.clock() + 8
local wanderGoal, wanderUntil = nil, 0

while model.Parent and humanoid.Health &gt; 0 do
	if model:GetAttribute("DogAI") == false then
		task.wait(0.5)
		continue
	end
	local target, dist = nearestPlayer()
	if target then
		wanderGoal = nil
		if dist &gt; NEAR then
			humanoid.WalkSpeed = dist &gt; FAR and RUN_SPEED or WALK_SPEED
			local dir = (target.Position - root.Position) * Vector3.new(1, 0, 1)
			humanoid:MoveTo(target.Position - dir.Unit * NEAR * 0.7)
			if obstacleAhead() then
				task.spawn(cueJump)
			end
		else
			humanoid:Move(Vector3.zero) -- stand beside the player
			-- face them
			local look = (target.Position - root.Position) * Vector3.new(1, 0, 1)
			if look.Magnitude &gt; 0.1 and root.CFrame.LookVector:Dot(look.Unit) &lt; 0.8 then
				humanoid.WalkSpeed = WALK_SPEED
				humanoid:MoveTo(root.Position + look.Unit * 0.5)
			end
			if os.clock() &gt; nextHop then
				nextHop = os.clock() + math.random(6, 12)
				task.spawn(cueJump) -- a happy hop
			end
		end
	else
		-- wander around home with idle pauses
		if not wanderGoal and os.clock() &gt; wanderUntil then
			local a = math.random() * math.pi * 2
			local r = math.random() * WANDER_RADIUS
			wanderGoal = home + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			humanoid.WalkSpeed = WALK_SPEED
		end
		if wanderGoal then
			humanoid:MoveTo(wanderGoal)
			if obstacleAhead() then
				task.spawn(cueJump)
			end
			if ((wanderGoal - root.Position) * Vector3.new(1, 0, 1)).Magnitude &lt; 2 * scale then
				wanderGoal = nil
				wanderUntil = os.clock() + math.random(2, 6)
				humanoid:Move(Vector3.zero)
			end
		end
	end
	task.wait(0.15)
end
</ProtectedString></Properties></Item>
</Item></roblox>
